{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "cl.bferal.ventory.desktop",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/resources/",
  "url": "https://ventory.bferal.cl",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "app.*",
    "os.*",
    "window.*",
    "storage.*",
    "filesystem.getStats",
    "debug.log"
  ],
  "commandAllowList": [
    "reg.exe",
    "reg",
    "powershell.exe",
    "powershell"
  ],
  "modes": {
    "window": {
      "title": "VENTORY",
      "width": 1320,
      "height": 860,
      "minWidth": 960,
      "minHeight": 600,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/resources/icons/appIcon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": false,
      "useSavedState": true,
      "injectClientLibrary": true,
      "injectScript": "/resources/js/main.js",
      "extendUserAgentWith": "VentoryDesktop/1.0",
      "newWindowPolicy": "browser"
    },
    "browser": {
      "nativeBlockList": ["filesystem.*"]
    },
    "chrome": {
      "width": 1320,
      "height": 860,
      "nativeBlockList": ["filesystem.*", "os.*"]
    }
  },
  "cli": {
    "binaryName": "ventory",
    "resourcesPath": "/resources/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/resources/js/neutralino.js",
    "binaryVersion": "6.10.0",
    "clientVersion": "6.10.0"
  }
}
